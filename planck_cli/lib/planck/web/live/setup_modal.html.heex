<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
     phx-window-keydown="close_setup"
     phx-key="Escape">
  <div class="border-2 border-black bg-card shadow-[8px_8px_0px_#000] w-full max-w-md flex flex-col max-h-[90vh] overflow-hidden">

    <%!-- Header --%>
    <div class="border-b-2 border-border px-4 py-3 flex items-center justify-between bg-card flex-shrink-0">
      <div>
        <p class="font-bold font-mono text-sm"><%= pgettext("setup title", "Configure Planck") %></p>
        <p class="font-mono text-xs text-muted-foreground">
          <%= step_subtitle(@step, @sub_step, @provider_model_mode, @first_run) %>
        </p>
      </div>
      <%= unless @first_run do %>
        <button
          class="border-2 border-black px-3 py-1 font-mono text-xs font-bold
                 shadow-[2px_2px_0px_#000] hover:shadow-[4px_4px_0px_#000]
                 hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all bg-card"
          phx-click="close_setup"
        >✕</button>
      <% end %>
    </div>

    <div class="p-4 space-y-4 flex-1 overflow-y-auto">

      <%= cond do %>

        <%!-- Step :choose — returning user action picker --%>
        <% @step == :choose -> %>
          <.live_component
            module={Planck.Web.Live.SetupModal.ChooseStep}
            id="choose-step"
            parent_id={@id}
            first_run={@first_run}
            configured_providers={@configured_providers}
          />

        <%!-- Step :keys — API key management --%>
        <% @step == :keys -> %>
          <.live_component
            module={Planck.Web.Live.SetupModal.KeysStep}
            id="keys-step"
            parent_id={@id}
          />

        <%!-- Step :service — service rule configuration --%>
        <% @step == :service -> %>
          <.live_component
            module={Planck.Web.Live.SetupModal.ServiceStep}
            id="service-step"
            parent_id={@id}
          />

        <%!-- Step :provider_model — provider + model flow --%>
        <% true -> %>
          <.live_component
            module={Planck.Web.Live.SetupModal.ProviderModelStep}
            id="provider-model-step"
            parent_id={@id}
            mode={@provider_model_mode}
            configured_providers={@configured_providers}
          />

      <% end %>

    </div>

    <%!-- Buttons --%>
    <div class="flex justify-between p-4 border-t-2 border-border flex-shrink-0">
      <div>
        <%= if (@step == :provider_model and @sub_step == :model) or @step in [:keys, :service] do %>
          <button
            class="border-2 border-black px-4 py-1.5 font-bold font-mono text-sm
                   shadow-[2px_2px_0px_#000] hover:shadow-[4px_4px_0px_#000]
                   hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all bg-card"
            phx-click="back"
            phx-target={@myself}
          ><%= pgettext("setup button", "Back") %></button>
        <% end %>
      </div>

      <div>
        <%= cond do %>
          <% @step == :provider_model and @sub_step == :provider -> %>
            <button
              class="border-2 border-black px-4 py-1.5 font-bold font-mono text-sm
                     shadow-[2px_2px_0px_#000] hover:shadow-[4px_4px_0px_#000]
                     hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all
                     bg-primary text-primary-foreground"
              phx-click="next"
              phx-target={@myself}
            ><%= pgettext("setup button", "Next") %></button>

          <% @step == :provider_model and @sub_step == :model -> %>
            <button
              class="border-2 border-black px-4 py-1.5 font-bold font-mono text-sm
                     shadow-[2px_2px_0px_#000] hover:shadow-[4px_4px_0px_#000]
                     hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all
                     bg-primary text-primary-foreground disabled:opacity-50"
              phx-click="save"
              phx-target={@myself}
              disabled={@saving}
            ><%= if @saving, do: pgettext("setup button", "Saving…"), else: pgettext("setup button", "Save") %></button>

          <% true -> %>
        <% end %>
      </div>
    </div>

  </div>
</div>
